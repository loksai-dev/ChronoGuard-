# OpenRouter / Jev
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
OPENROUTER_CHAT_MODEL=typesafe/jev-router
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=ChronoGuard
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=2

# Confidence / routing
JEV_CONFIDENCE_THRESHOLD=0.85
JEV_MALICIOUS_THRESHOLD=0.70
MAX_RETRIES=3

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=chronoguard

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=chronoguard_knowledge

# Embeddings (hashing = local demo; openai_compatible uses OPENAI_COMPAT_* )
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=384
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_EMBEDDING_MODEL=text-embedding-3-small

# App
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
DEMO_INCIDENT_TIME=2026-09-27T02:14:00Z
